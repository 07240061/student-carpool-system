
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Dashboard | CampusRide</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header class="site-header">
    <nav class="navbar">

        <a href="/student/dashboard" class="brand">
            🚗 CampusRide
        </a>

        <div class="nav-links">
            <a href="/student/dashboard">🏠 Dashboard</a>
            <a href="/trips/search">🔎 Browse Trips</a>
            <a href="/bookings">🎫 My Bookings</a>
            <a href="/profile">👤 My Profile</a>
            <a href="/logout">Logout</a>
        </div>

    </nav>
</header>

<main class="student-dashboard">

    <!-- Welcome Section -->
    <section class="student-hero">
        <h1>Welcome, Student! 👋</h1>

        <p>
            Find a ride and travel together with fellow students.
            Your next journey starts here!
        </p>
    </section>

    <!-- Dashboard Cards -->
    <h2 class="student-section-title">
        What would you like to do?
    </h2>

    <section class="student-actions">

        <!-- Browse Trips -->
        <a href="/trips/search" class="student-card">

            <div class="student-icon">🔎</div>

            <h3>Browse Trips</h3>

            <p>
                Find drivers travelling to your destination
                and explore available seats.
            </p>

            <span class="student-card-link">
                Browse Trips →
            </span>

        </a>

        <!-- My Bookings -->
        <a href="/bookings" class="student-card">

            <div class="student-icon">🎫</div>

            <h3>My Bookings</h3>

            <p>
                Check your seat requests and see whether
                drivers have accepted them.
            </p>

            <span class="student-card-link">
                Check Bookings →
            </span>

        </a>

        <!-- Find a Journey -->
        <a href="/trips/search" class="student-card">

            <div class="student-icon">🗺️</div>

            <h3>Find Your Journey</h3>

            <p>
                Explore available routes, destinations
                and departure times.
            </p>

            <span class="student-card-link">
                Find a Ride →
            </span>

        </a>

        <!-- Profile -->
        <a href="/profile" class="student-card">

            <div class="student-icon">👤</div>

            <h3>My Profile</h3>

            <p>
                View and manage your personal
                account information.
            </p>

            <span class="student-card-link">
                View Profile →
            </span>

        </a>

    </section>

</main>

<footer class="site-footer">
    <p>
        © 2026 CampusRide | Share your ride. Travel together.
    </p>
</footer>

</body>
</html>
