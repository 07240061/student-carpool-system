<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | Student Carpool</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="container">
    <h1>Student Carpool System</h1>
    <h2>Create an account</h2>
    <% if (verificationSent) { %>
      <p class="success">Account created. Check your email and click the verification link before logging in. The link expires in 24 hours.</p>
    <% } %>
    <% if (typeof resendMessage !== 'undefined' && resendMessage) { %>
      <p class="success"><%= resendMessage %></p>
    <% } %>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form action="/register" method="POST">
      <label for="full_name">Full name</label>
      <input id="full_name" name="full_name" type="text" required>
      <label for="email">Email</label>
      <input id="email" name="email" type="email" required>
      <label for="password">Password (at least 8 characters)</label>
      <input id="password" name="password" type="password" minlength="8" required>
      <button type="submit">Register</button>
      
<div class="form-group">
  <label for="role">Register as</label>
  <select id="role" name="role" required>
    <option value="student">Student</option>
    <option value="driver">Driver</option>
  </select>
</div>
    </form>
    <section aria-labelledby="resend-verification-heading">
      <h3 id="resend-verification-heading">Didn't receive the email?</h3>
      <form action="/resend-verification" method="POST">
        <label for="resend_email">Email address</label>
        <input id="resend_email" name="email" type="email" required>
        <button type="submit">Resend verification email</button>
      </form>
    </section>
    <p>Already have an account? <a href="/login">Log in</a></p>
    <p><a href="/">Back to home</a></p>
  </main>
</body>
</html>